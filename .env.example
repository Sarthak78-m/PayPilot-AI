# ==============================================================================
# PayPilot AI — Environment Configuration Template (.env.example)
# Copy this file to .env.local and configure your credentials.
# Do NOT commit .env or .env.local to version control.
# ==============================================================================

# Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Managed Database & Auth Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# Google Gemini API Key (AI Financial Pilot & Smart Invoicing)
GEMINI_API_KEY=your-gemini-api-key

# ==============================================================================
# PayPal Developer Sandbox Gateway Configuration
# Obtain credentials from: https://developer.paypal.com/dashboard/applications/sandbox
# ==============================================================================
PAYPAL_CLIENT_ID=YOUR_SANDBOX_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_SANDBOX_CLIENT_SECRET
PAYPAL_MODE=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=USD

# Public client ID for browser-side official PayPal JavaScript SDK
NEXT_PUBLIC_PAYPAL_CLIENT_ID=YOUR_SANDBOX_CLIENT_ID

# Payment Checkout Feature Activation (Must be set to "true" to activate checkout)
PAYMENT_CHECKOUT_ENABLED=true
NEXT_PUBLIC_PAYMENT_CHECKOUT_ENABLED=true
